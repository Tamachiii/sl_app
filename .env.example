VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (rest-timer "Rest done" lock-screen notification).
# Generate a pair once via:  npx web-push generate-vapid-keys --json
# The PUBLIC key is shipped to the client (here). The PRIVATE key + a
# `mailto:` subject go into Supabase Edge Function secrets:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# Supabase CLI, for applying migrations (server-side only — deliberately NOT
# VITE_-prefixed, so Vite never bundles them into the client).
#   supabase db query --linked --file supabase/migrations/<file>.sql --agent yes
# Token comes from the Supabase dashboard. Note the CLI's validator accepts
# `sbp_<40 hex>`; if the dashboard hands you `sbp_v0_<40 hex>`, drop the `v0_`.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
